package {
    default_applicable_licenses: ["//device/jide/sk1wg:device_jide_sk1wg_license"],
}

cc_binary {
    name: "android.hardware.light-service.sk1wg",
    relative_install_path: "hw",
    vendor: true,
    init_rc: ["android.hardware.light-service.sk1wg.rc"],
    vintf_fragments: ["android.hardware.light-service.sk1wg.xml"],
    srcs: ["Lights.cpp"],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "android.hardware.light-V2-ndk",
    ],
    cflags: ["-Wall", "-Werror"],
}
