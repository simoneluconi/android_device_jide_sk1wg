# Android fstab for the Jide Remix Ultra Tablet (sk1wg), stock GPT.
# APP is /system (vendor included, as /system/vendor) and CAC (stock
# /cache) is /system_ext; there is no /cache.
# Never add MDA, MSC writes beyond the bootloader message, USP or any
# other partition: see the anti-brick rules in CLAUDE.md.
#
# <src>                                           <mnt_point>  <type>  <mnt_flags and options>                                         <fs_mgr_flags>
/dev/block/platform/sdhci-tegra.3/by-name/APP     /system      ext4    ro,noatime                                                      wait,first_stage_mount
/dev/block/platform/sdhci-tegra.3/by-name/CAC     /system_ext  ext4    ro,noatime                                                      wait,first_stage_mount
/dev/block/platform/sdhci-tegra.3/by-name/UDA     /data        ext4    noatime,nosuid,nodev,noauto_da_alloc,errors=panic               wait,check,formattable
/dev/block/platform/sdhci-tegra.3/by-name/MSC     /misc        emmc    defaults                                                        defaults

# vold-managed volumes ("block device" is actually a sysfs devpath)
/devices/platform/sdhci-tegra.2/mmc_host/mmc1*    auto         auto    defaults                                                        voldmanaged=sdcard1:auto
/devices/platform/tegra-ehci.0*                   auto         auto    defaults                                                        voldmanaged=usb:auto

# zram: 512 MB on 2 GB of RAM
/dev/block/zram0                                  none         swap    defaults                                                        zramsize=536870912
