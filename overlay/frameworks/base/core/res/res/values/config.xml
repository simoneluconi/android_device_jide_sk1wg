<resources>
    <!-- Wi-Fi only tablet -->
    <bool name="config_voice_capable">false</bool>
    <bool name="config_sms_capable">false</bool>
    <bool name="config_mobile_data_capable">false</bool>

    <!-- Adaptive brightness from the CM3217 light sensor. The sensors HAL
         reports its raw ADC count as lux (about 0.3 lux per step), so these
         are stock Remix OS's tables for that scale. -->
    <bool name="config_automatic_brightness_available">true</bool>
    <integer-array name="config_autoBrightnessLevels">
        <item>30</item>
        <item>60</item>
        <item>90</item>
        <item>150</item>
        <item>200</item>
        <item>320</item>
        <item>600</item>
        <item>1200</item>
        <item>1800</item>
        <item>2400</item>
        <item>5000</item>
    </integer-array>
    <integer-array name="config_autoBrightnessLcdBacklightValues">
        <item>13</item>
        <item>36</item>
        <item>59</item>
        <item>82</item>
        <item>105</item>
        <item>128</item>
        <item>151</item>
        <item>174</item>
        <item>197</item>
        <item>220</item>
        <item>242</item>
        <item>255</item>
    </integer-array>

    <!-- pwm-backlight: 0..255 -->
    <integer name="config_screenBrightnessSettingMinimum">10</integer>
    <integer name="config_screenBrightnessSettingDefault">102</integer>
    <integer name="config_screenBrightnessSettingMaximum">255</integer>

    <!-- The keyboard dock: hardware keyboard is the normal input -->
    <bool name="config_showNavigationBar">true</bool>

    <!-- The keyboard cover has a magnet: the "sw-key" input device reports
         SW_LID. Closing the cover puts the tablet to sleep, opening it wakes
         it up. This sets the initial Settings.Global.LID_BEHAVIOR (SLEEP). -->
    <bool name="config_lidControlsSleep">true</bool>

    <!-- Low-end GPU: no blur, simpler effects -->
    <bool name="config_supportsMultiWindow">true</bool>

    <!-- Rotation: landscape is the natural orientation of this tablet -->
    <bool name="config_supportAutoRotation">true</bool>

    <!-- zram is set up in the fstab -->
    <bool name="config_zramWriteback">false</bool>
</resources>
