//
// Shims for NVIDIA's Android 5.1 graphics blobs, added to them with
// TARGET_LD_SHIM_LIBS (BoardConfig.mk).

package {
    default_applicable_licenses: ["//device/jide/sk1wg:device_jide_sk1wg_license"],
}

cc_library_shared {
    name: "libshim_atomic",
    vendor: true,
    srcs: ["atomic.c"],
    cflags: ["-Wall", "-Werror"],
}

// Binder-free stand-ins for NVIDIA's Control Panel client libraries
// (see nvcpl_stub.c); same names, so the blobs' DT_NEEDED find them.
cc_library_shared {
    name: "libnvcpl",
    vendor: true,
    srcs: ["nvcpl_stub.c"],
    cflags: ["-Wall", "-Werror", "-DNVCPL_FULL"],
}

cc_library_shared {
    name: "libcplconnectclient",
    vendor: true,
    srcs: ["nvcpl_stub.c"],
    cflags: ["-Wall", "-Werror"],
}

// In front of NVIDIA's EGL loader, which is installed as libEGL_tegra_nv.so
// (see egl_tegra.c).
cc_library_shared {
    name: "libEGL_tegra",
    vendor: true,
    relative_install_path: "egl",
    srcs: ["egl_tegra.c"],
    shared_libs: ["liblog"],
    header_libs: ["gl_headers"],
    cflags: ["-Wall", "-Werror"],
}

cc_library_shared {
    name: "libshim_graphicbuffer",
    vendor: true,
    srcs: ["graphicbuffer.cpp"],
    shared_libs: ["libui", "libutils", "libcutils"],
    header_libs: ["libnativebase_headers"],
    cflags: ["-Wall", "-Werror"],
}
